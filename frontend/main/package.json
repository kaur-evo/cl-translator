{
  "name": "Evocon",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite --mode serve",
    "serve:live": "vite --mode production --port 8081",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "lint": "eslint ./src --ext .js,.ts,.vue",
    "build:dev": "vue-tsc --noEmit && vite build --mode dev && npm run es-check",
    "build:development": "vue-tsc --noEmit && vite build --mode development && npm run es-check",
    "build:live": "vue-tsc --noEmit && vite build --mode production && npm run es-check",
    "es-check": "es-check es6 ./dist/**/*.js --not=./dist/service-worker.js",
    "generate-tests": "npm --prefix ../vue-tests-generator/ run compile && node ../vue-tests-generator/out/cli.js src/components",
    "i18n:report": "vue-cli-service i18n:report --src './src/**/*.?(js|vue)' --locales './src/locales/**/*.json'",
    "generate-stories": "npm --prefix ../vue-tests-generator/ run compile && node ../vue-tests-generator/out/cli.js src/components --story",
    "generate-translations": "npm --prefix ../vue-tests-generator/ run compile && node ../vue-tests-generator/out/cli.js src --translation",
    "cli": "npm --prefix ../evocon-cli/ run compile && node ../evocon-cli/dist/main.js",
    "chromatic": "npx chromatic --project-token=43a0b557fff0"
  },
